# Alworki — variables de entorno (copia a Backend/.env)

# --- Supabase (recomendado para producción) ---
# Project Settings → API
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_ANON_KEY=eyJ...
# Solo en el servidor Flask (nunca en Flutter release sin protección)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Database → Connection string → URI (modo Session o Transaction)
# Usa la contraseña de la base de datos, no la anon key
DATABASE_URL=postgresql://postgres.TU_REF:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# JWT del backend (tokens de la app móvil)
JWT_SECRET_KEY=cambia-esto-en-produccion

# CORS adicional (coma-separado)
# CORS_ORIGINS=https://tu-dominio.com

# --- Flutter (dart-define) ---
# flutter run --dart-define=SUPABASE_URL=https://... --dart-define=SUPABASE_ANON_KEY=eyJ...
# flutter run --dart-define=API_BASE_URL=http://TU_IP:5002
